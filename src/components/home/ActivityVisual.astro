---
import { mulberry32 } from '@/utils/embedding-field';

interface Props {
  kind: 'attention' | 'scatter' | 'lanes' | 'brackets' | 'graph';
}

const { kind } = Astro.props;
const rand = mulberry32(kind.length * 97 + 13);
const r1 = (n: number) => Math.round(n * 10) / 10;

// attention: a small attention-weight heat-map with a diagonal ridge.
const cols = 14;
const rows = 8;
const cells = Array.from({ length: rows * cols }, (_, i) => {
  const row = Math.floor(i / cols);
  const col = i % cols;
  const ridge = Math.exp(-Math.pow(col - (row * (cols - 1)) / (rows - 1), 2) / 5);
  return { x: col * 17, y: row * 17, o: r1(Math.min(1, 0.08 + 0.85 * ridge * (0.55 + 0.45 * rand()) + 0.1 * rand())) };
});

// scatter: noisy points along a fitted line.
const dots = Array.from({ length: 30 }, (_, i) => {
  const x = 14 + (i / 29) * 192;
  const y = 118 - (x - 14) * 0.46 + (rand() - 0.5) * 34;
  return { x: r1(x), y: r1(Math.min(124, Math.max(10, y))) };
});

// lanes: request lanes with packets.
const lanes = [20, 46, 72, 98].map((y) => ({
  y,
  packets: Array.from({ length: 2 + Math.floor(rand() * 2) }, () => ({
    x: r1(10 + rand() * 130),
    w: r1(14 + rand() * 22),
  })),
}));

// graph: a small data → model → service graph.
const nodes = [
  { x: 22, y: 56, r: 7 },
  { x: 78, y: 22, r: 5 },
  { x: 78, y: 90, r: 5 },
  { x: 140, y: 56, r: 10 },
  { x: 200, y: 24, r: 5 },
  { x: 200, y: 88, r: 5 },
  { x: 244, y: 56, r: 7 },
];
const edges = [[0, 1], [0, 2], [1, 3], [2, 3], [3, 4], [3, 5], [4, 6], [5, 6]];
---

<div class:list={['viz', `viz--${kind}`]} aria-hidden="true">
  {
    kind === 'attention' && (
      <svg viewBox="0 0 238 136" focusable="false">
        {cells.map((c) => <rect x={c.x} y={c.y} width="13" height="13" rx="3.5" opacity={c.o} />)}
      </svg>
    )
  }
  {
    kind === 'scatter' && (
      <svg viewBox="0 0 220 140" focusable="false">
        <path class="viz__axis" d="M10 8 V128 H212" />
        <path class="viz__line" d="M14 118 L206 30" />
        {dots.map((d) => <circle cx={d.x} cy={d.y} r="2.6" />)}
      </svg>
    )
  }
  {
    kind === 'lanes' && (
      <svg viewBox="0 0 220 120" focusable="false">
        {lanes.map((lane) => (
          <g>
            <path class="viz__lane" d={`M6 ${lane.y} H170`} />
            {lane.packets.map((p) => <rect x={p.x} y={lane.y - 4} width={p.w} height="8" rx="3" />)}
          </g>
        ))}
        <rect class="viz__bar" x="176" y="6" width="12" height="108" rx="4" />
        <path class="viz__lane" d="M188 60 H214" />
        <circle cx="214" cy="60" r="4" />
      </svg>
    )
  }
  {
    kind === 'brackets' && (
      <svg viewBox="0 0 120 90" focusable="false">
        <path class="viz__stroke" d="M44 18 L14 45 L44 72" />
        <path class="viz__stroke" d="M76 18 L106 45 L76 72" />
        <path class="viz__stroke viz__stroke--thin" d="M68 12 L52 78" />
      </svg>
    )
  }
  {
    kind === 'graph' && (
      <svg viewBox="0 0 260 110" focusable="false">
        {edges.map(([a, b]) => <path class="viz__lane" d={`M${nodes[a].x} ${nodes[a].y} L${nodes[b].x} ${nodes[b].y}`} />)}
        {nodes.map((n) => <circle cx={n.x} cy={n.y} r={n.r} />)}
      </svg>
    )
  }
</div>
