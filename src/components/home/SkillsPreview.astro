---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import SkillItem from '@/components/ui/SkillItem.astro';
import Icon from '@/components/ui/Icon.astro';
import { skills } from '@/data/skills';
import type { Skill } from '@/types/content';

const groups = new Map<string, Skill[]>();
for (const skill of skills) {
  groups.set(skill.category, [...(groups.get(skill.category) ?? []), skill]);
}
const entries = Array.from(groups.entries());
---

<section id="skills" class="skills" aria-labelledby="skills-title">
  <SectionHeading id="skills-title" size="md" title="مهارت‌ها" />

  {
    entries.length > 0 ? (
      <div class="skill-groups">
        {entries.map(([category, items]) => (
          <div class="skill-group">
            <h3 class="skill-group__title">{category}</h3>
            <ul class="skill-list" role="list">
              {items.map((skill) => <SkillItem skill={skill} />)}
            </ul>
          </div>
        ))}
      </div>
    ) : (
      <div class="empty">
        <span class="empty__icon"><Icon name="layers" /></span>
        <p class="empty__title">مهارت‌ها هنوز اضافه نشده‌اند.</p>
        <p class="empty__text">پس از تکمیل، مهارت‌ها در همین بخش دسته‌بندی و نمایش داده می‌شوند.</p>
      </div>
    )
  }
</section>
