---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import BlogSlider from './BlogSlider.astro';
import { getHomepageArticles, blogHomeUrl } from '@/utils/blog';

const articles = await getHomepageArticles();
const blogHome = blogHomeUrl();
---

<section id="blog" class="blog theme-paper" aria-labelledby="blog-title" data-nav-section="blog">
  <div class="container blog__inner">
    <div class="rule" data-reveal-rule aria-hidden="true"></div>

    <div class="blog__head">
      <SectionHeading
        id="blog-title"
        size="xl"
        title="بلاگ"
        lede="یادداشت‌هایی درباره‌ی هوش مصنوعی، مهندسی نرم‌افزار و چیزهایی که در مسیر یادگیری و ساختن به آن‌ها می‌رسم."
      />
      {
        blogHome && (
          <Button class="blog__all" href={blogHome} variant="secondary" icon="external-link">
            ورود به بلاگ
          </Button>
        )
      }
    </div>

    {
      articles.length > 0 ? (
        <BlogSlider articles={articles} />
      ) : (
        <div class="blog__empty">
          <div class="blog__empty-cover" aria-hidden="true">
            <Icon name="pen-line" />
          </div>
          <div class="blog__empty-text">
            <p class="blog__empty-title">هنوز مطلبی در بلاگ منتشر نشده است.</p>
            <p>وقتی اولین مطلب آماده شود، همین‌جا در یک اسلایدر نمایش داده می‌شود.</p>
          </div>
        </div>
      )
    }
  </div>
</section>
