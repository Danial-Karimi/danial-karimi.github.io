---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/home/Hero.astro';
import IntroductionPreview from '@/components/home/IntroductionPreview.astro';
import ActivitiesPreview from '@/components/home/ActivitiesPreview.astro';
import EducationPreview from '@/components/home/EducationPreview.astro';
import SkillsPreview from '@/components/home/SkillsPreview.astro';
import BlogPreview from '@/components/home/BlogPreview.astro';
import ContactPreview from '@/components/home/ContactPreview.astro';
---

<BaseLayout>
  <Hero />
  <IntroductionPreview />
  <ActivitiesPreview />

  <div class="section duo">
    <div class="container">
      <div class="rule" data-reveal-rule aria-hidden="true"></div>
      <div class="duo__grid">
        <EducationPreview />
        <SkillsPreview />
      </div>
    </div>
  </div>

  <BlogPreview />
  <ContactPreview />
</BaseLayout>
