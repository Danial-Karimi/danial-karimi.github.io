---
import '@fontsource-variable/vazirmatn';
import '@/styles/global.css';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import BackToTop from '@/components/ui/BackToTop.astro';
import { siteConfig } from '@/data/site';
import { absoluteUrl, personJsonLd, websiteJsonLd, serializeJsonLd } from '@/utils/seo';

interface Props {
  title?: string;
  description?: string;
  /** Path (e.g. "/images/og-default.png") or absolute URL. */
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  /** Extra JSON-LD blocks (e.g. BlogPosting on future article pages). */
  jsonLd?: object[];
  /** Person + WebSite JSON-LD. Disabled automatically for noindex pages. */
  identity?: boolean;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  ogImage = siteConfig.ogImage,
  ogType = 'website',
  noindex = false,
  jsonLd = [],
  identity = !noindex,
} = Astro.props;

const canonical = absoluteUrl(Astro.url.pathname);
const image = /^https?:\/\//.test(ogImage) ? ogImage : absoluteUrl(ogImage);
const schemas = [...(identity ? [personJsonLd(), websiteJsonLd()] : []), ...jsonLd].map(serializeJsonLd);
---

<!doctype html>
<html lang={siteConfig.lang} dir={siteConfig.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content={siteConfig.themeColor} />
    <meta name="color-scheme" content="dark" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:locale" content={siteConfig.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content={String(siteConfig.ogImageWidth)} />
    <meta property="og:image:height" content={String(siteConfig.ogImageHeight)} />
    <meta property="og:image:alt" content={siteConfig.ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={siteConfig.ogImageAlt} />

    <script is:inline>document.documentElement.classList.add('js');</script>
    {schemas.map((json) => <script type="application/ld+json" is:inline set:html={json} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">پرش به محتوای اصلی</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <BackToTop />
    <script>
      import '@/scripts/reveal';
    </script>
  </body>
</html>
